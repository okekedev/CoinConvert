    "NSCameraUsageDescription": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise usa la cámara para leer precios y convertirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise utilise l'appareil photo pour lire les prix et les convertir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise nutzt die Kamera, um Preise zu lesen und umzurechnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise usa la fotocamera per leggere i prezzi e convertirli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tagwise usa a câmera para ler preços e convertê-los."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwiseは値札を読み取って換算するためにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise는 가격을 읽고 환산하기 위해 카메라를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise 使用相机读取并换算价格。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise usa tu ubicación para elegir la moneda local cuando viajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise utilise votre position pour choisir la devise locale en voyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise nutzt deinen Standort, um auf Reisen die Landeswährung zu wählen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise usa la tua posizione per scegliere la valuta locale quando viaggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tagwise usa sua localização para escolher a moeda local quando você viaja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwiseは旅行先の現地通貨を選ぶために位置情報を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise는 여행 중 현지 통화를 선택하기 위해 위치를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise 使用你的位置在旅行时选择当地货币。"
          }
        }
      }
    }
  },
  "version": "1.0"
