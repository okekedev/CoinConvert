    "Tagwise respects your privacy. Your currency preferences and exchange rates are stored only on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise respektiert deine Privatsphäre. Deine Währungen und Kurse werden nur auf deinem Gerät gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise respeta tu privacidad. Tus monedas y tipos de cambio solo se guardan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise respecte votre vie privée. Vos devises et taux de change restent uniquement sur votre appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise menghormati privasimu. Pilihan mata uang dan kurs hanya disimpan di perangkatmu."
