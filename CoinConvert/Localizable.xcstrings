        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise rispetta la tua privacy. Valute e tassi di cambio restano solo sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwiseはプライバシーを尊重します。通貨設定と為替レートは端末内にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise는 개인정보를 존중합니다. 통화 설정과 환율은 기기에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise respecteert je privacy. Je valuta en wisselkoersen worden alleen op je toestel opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tagwise respeita sua privacidade. Suas moedas e cotações ficam só no seu aparelho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tagwise respeita a tua privacidade. As tuas moedas e taxas de câmbio ficam só no teu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise уважает вашу конфиденциальность. Выбранные валюты и курсы хранятся только на вашем устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise เคารพความเป็นส่วนตัวของคุณ สกุลเงินที่เลือกและอัตราแลกเปลี่ยนเก็บไว้ในเครื่องของคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise gizliliğinize saygı duyar. Para birimi tercihleriniz ve kurlar yalnızca cihazınızda saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise 尊重你的隐私。你的货币偏好和汇率只保存在本机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagwise 尊重你的隱私。你的貨幣偏好和匯率只保存在本機。"
          }
        }
      }
    },
