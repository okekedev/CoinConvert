    "Unlock camera scanning forever.\nPay once. No subscription.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneo con cámara para siempre.\nUn solo pago. Sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
