    "Tagwise respects your privacy. Your currency preferences and exchange rates are stored only on your device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise respeta tu privacidad. Tus monedas y tipos de cambio solo se guardan en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise respecte votre vie privée. Vos devises et taux de change restent uniquement sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise respektiert deine Privatsphäre. Deine Währungen und Kurse werden nur auf deinem Gerät gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise rispetta la tua privacy. Valute e tassi di cambio restano solo sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tagwise respeita sua privacidade. Suas moedas e cotações ficam só no seu aparelho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwiseはプライバシーを尊重します。通貨設定と為替レートは端末内にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise는 개인정보를 존중합니다. 통화 설정과 환율은 기기에만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwise 尊重你的隐私。你的货币偏好和汇率只保存在本机。"
          }
        }
      }
